<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_craf_sex" model="ir.actions.client">
        <field name="name">Sexlar</field>
        <field name="tag">craf_sex</field>
        <field name="path">craf-sex</field>
    </record>
    <!-- har bo'limning o'z sahifasi: Press — faqat press; Bo'yash va qadoqlash — kimyoviy ishlov va bo'yash -->
    <record id="action_craf_sex_press" model="ir.actions.client">
        <field name="name">Press</field>
        <field name="tag">craf_sex</field>
        <field name="path">craf-bolim-press</field>
        <field name="context">{'craf_bolim': 'press', 'craf_stage': 'press'}</field>
    </record>
    <record id="action_craf_sex_boyash" model="ir.actions.client">
        <field name="name">Bo'yash va qadoqlash</field>
        <field name="tag">craf_sex</field>
        <field name="path">craf-bolim-boyash</field>
        <field name="context">{'craf_bolim': 'boyash', 'craf_stage': 'boyash'}</field>
    </record>
    <!-- press xodimi: alohida «Press» ilovasi (faqat u ko'radi), telefonda pastki panel; daftardagidek smena va
         korzinkalar (har korzinka — o'z profili, KG 1 dona, kryuchok, palka, ikkinchi profil, brutto) -->
    <record id="action_craf_sex_press_own" model="ir.actions.client">
        <field name="name">Press</field>
        <field name="tag">craf_sex</field>
        <field name="path">craf-press-sahifa</field>
        <field name="context">{'craf_stage': 'press'}</field>
    </record>
    <menuitem id="menu_craf_press_root" name="Press" sequence="1"
              web_icon="craf_sex,static/description/icon.png" groups="craf_sex.group_craf_worker"/>
    <menuitem id="menu_craf_press_page" name="Press smenasi" parent="menu_craf_press_root"
              action="action_craf_sex_press_own" sequence="1"/>
    <!-- kimyo xodimi: alohida «Kimyo» ilovasi (faqat u ko'radi — models/ir_ui_menu.py), telefonda pastki panel -->
    <record id="action_craf_sex_kimyo" model="ir.actions.client">
        <field name="name">Kimyoviy ishlov</field>
        <field name="tag">craf_sex</field>
        <field name="path">craf-kimyo-sahifa</field>
        <field name="context">{'craf_stage': 'kimyo'}</field>
    </record>
    <menuitem id="menu_craf_kimyo_root" name="Kimyo" sequence="2"
              web_icon="craf_sex,static/description/icon.png" groups="craf_sex.group_craf_worker"/>
    <menuitem id="menu_craf_kimyo_page" name="Kimyoviy ishlov" parent="menu_craf_kimyo_root"
              action="action_craf_sex_kimyo" sequence="1"/>
    <!-- bo'yash va qadoqlash xodimi: alohida «Bo'yash» ilovasi (faqat u ko'radi), telefonda pastki panel -->
    <record id="action_craf_sex_boyash_own" model="ir.actions.client">
        <field name="name">Bo'yash va qadoqlash</field>
        <field name="tag">craf_sex</field>
        <field name="path">craf-boyash-sahifa</field>
        <field name="context">{'craf_stage': 'boyash'}</field>
    </record>
    <menuitem id="menu_craf_boyash_root" name="Bo'yash" sequence="4"
              web_icon="craf_sex,static/description/icon.png" groups="craf_sex.group_craf_worker"/>
    <menuitem id="menu_craf_boyash_page" name="Bo'yash va qadoqlash" parent="menu_craf_boyash_root"
              action="action_craf_sex_boyash_own" sequence="1"/>
    <!-- stiker sozlamalari: qoidalar (rang / profil → qalinlik, logo), normalar, turlar, logolar, tekshirish.
         Bo'yash xodimi — faqat ko'rish (Materiallar bo'limidan ochadi); omborchi, direktor, administrator — CRUD -->
    <record id="action_craf_stiker_sozlama" model="ir.actions.client">
        <field name="name">Stiker sozlamalari</field>
        <field name="tag">craf_stiker_sozlama</field>
        <field name="path">craf-stiker-sozlama</field>
    </record>
    <menuitem id="menu_craf_stiker_sozlama" name="Stiker sozlamalari" parent="craf_stiker.menu_craf_stiker"
              action="action_craf_stiker_sozlama" sequence="1"/>
    <menuitem id="menu_craf_sex_press" name="Press sahifasi" parent="craf_production.menu_craf_bolim_press"
              action="action_craf_sex_press" sequence="1"/>
    <menuitem id="menu_craf_sex_boyash" name="Bo'yash sahifasi" parent="craf_production.menu_craf_bolim_boyash"
              action="action_craf_sex_boyash" sequence="1"/>

    <record id="view_users_form_craf_sex" model="ir.ui.view">
        <field name="name">res.users.form.craf.sex</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']/group[1]" position="after">
                <group string="Craf" invisible="share">
                    <field name="craf_work_stage"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
