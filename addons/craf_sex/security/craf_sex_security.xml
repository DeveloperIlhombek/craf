<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_craf_zavod" model="res.groups.privilege">
        <field name="name">Zavod rollari</field>
        <field name="sequence">5</field>
        <field name="category_id" ref="craf_sotuv.module_category_craf"/>
        <field name="description">Sex ishchisi — o'z sexi hujjatlari; Hisobchi — hamma hujjatni ko'radi, 1C belgisi; Direktor — hammasi.</field>
    </record>

    <record id="group_craf_worker" model="res.groups">
        <field name="name">Sex ishchisi</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_craf_zavod"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user')), (4, ref('mrp.group_mrp_user'))]"/>
        <field name="comment">Литейка, Press, Kimyo yoki Bo'yash hujjatlarini yozadi va tasdiqlaydi. Bosh sahifasi — o'z sexi (foydalanuvchidagi «Ish joyi»).</field>
    </record>

    <record id="group_craf_accountant" model="res.groups">
        <field name="name">Hisobchi</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_craf_zavod"/>
        <field name="implied_ids" eval="[(4, ref('group_craf_worker')), (4, ref('sales_team.group_sale_salesman_all_leads')), (4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Barcha sex, ombor va sotuv hujjatlarini ko'radi, kunlik hisobotni 1C ga kiritadi («1C ga kiritildi» belgisi), hisob-fakturalar. Bosh sahifasi — Kunlik hisobot.</field>
    </record>

    <record id="group_craf_director" model="res.groups">
        <field name="name">Direktor</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_craf_zavod"/>
        <field name="implied_ids" eval="[(4, ref('group_craf_accountant')), (4, ref('stock.group_stock_manager')), (4, ref('mrp.group_mrp_manager')), (4, ref('sales_team.group_sale_manager'))]"/>
        <field name="comment">Hamma narsani ko'radi va boshqaradi (ombor, ishlab chiqarish, sotuv rahbari). Bosh sahifasi — Panel.</field>
    </record>
</odoo>
