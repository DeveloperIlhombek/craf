<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_craf_vehicle" model="ir.ui.view">
        <field name="name">stock.picking.form.craf.vehicle</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="craf_vehicle" invisible="picking_type_code != 'incoming' and not craf_vehicle"/>
            </field>
        </field>
    </record>
    <record id="vpicktree_craf_vehicle" model="ir.ui.view">
        <field name="name">stock.picking.list.craf.vehicle</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="craf_vehicle" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
