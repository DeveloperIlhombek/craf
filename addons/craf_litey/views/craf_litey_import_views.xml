<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="craf_litey_import_view_form" model="ir.ui.view">
        <field name="name">craf.litey.import.form</field>
        <field name="model">craf.litey.import</field>
        <field name="arch" type="xml">
            <form string="Excel jadvalidagi qoldiqni yuklash">
                <field name="state" invisible="1"/>
                <div invisible="state != 'upload'">
                    <p class="text-muted">
                        Литейка Excel jadvalini (Лист1: birinchi qatorda kunlar, A ustunda nomlar) tanlang.
                        Odoo qoldig'i shu kundagi Excel raqami bilan taqqoslanadi; farqlarni ko'rib, keyin yuklaysiz.
                    </p>
                    <group>
                        <group>
                            <field name="file" filename="filename" required="state == 'upload'"/>
                            <field name="filename" invisible="1"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="moment" widget="radio"/>
                            <field name="fill_prev"/>
                            <field name="consolidate"/>
                        </group>
                    </group>
                </div>
                <div invisible="state != 'preview'">
                    <div class="d-flex gap-3 text-muted mb-2">
                        <span>Fayldagi kunlar: <field name="dates_info" class="oe_inline"/></span>
                        <span>Ustun: <field name="date" readonly="1" class="oe_inline"/></span>
                        <span><field name="moment" readonly="1" class="oe_inline"/></span>
                        <span>Farqli: <field name="diff_count" class="oe_inline fw-bold"/></span>
                    </div>
                    <field name="line_ids">
                        <list editable="bottom" create="0" delete="0"
                              decoration-muted="skip" decoration-warning="apply and abs(diff) &gt; 0.005">
                            <field name="excel_name"/>
                            <field name="product_id" options="{'no_create': True}" readonly="skip"/>
                            <field name="value_date" optional="hide"/>
                            <field name="excel_qty" readonly="skip"/>
                            <field name="odoo_qty"/>
                            <field name="diff"/>
                            <field name="uom_name" string=""/>
                            <field name="location_id" options="{'no_create': True}" optional="show" readonly="skip"/>
                            <field name="apply" readonly="skip"/>
                            <field name="note"/>
                            <field name="skip" column_invisible="1"/>
                        </list>
                    </field>
                </div>
                <footer>
                    <button name="action_parse" type="object" string="Taqqoslash" class="btn-primary"
                            invisible="state != 'upload'" icon="fa-search"/>
                    <button name="action_apply" type="object" string="Belgilanganlarni yuklash" class="btn-primary"
                            invisible="state != 'preview'" icon="fa-check"
                            confirm="Belgilangan materiallar qoldig'i Excel dagi raqamga tuzatiladi (inventarizatsiya). Davom etasizmi?"/>
                    <button name="action_back" type="object" string="Orqaga" invisible="state != 'preview'"/>
                    <button string="Bekor" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_craf_litey_import" model="ir.actions.act_window">
        <field name="name">Excel jadvalidagi qoldiqni yuklash</field>
        <field name="res_model">craf.litey.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
