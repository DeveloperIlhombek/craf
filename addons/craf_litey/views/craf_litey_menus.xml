<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_craf_litey" model="ir.actions.client">
        <field name="name">Литейка</field>
        <field name="tag">craf_litey</field>
        <field name="path">craf-litey</field>
    </record>
    <record id="action_craf_litey_prognoz" model="ir.actions.client">
        <field name="name">Liteyka xom-ashyosi</field>
        <field name="tag">craf_litey</field>
        <field name="path">craf-litey-xomashyo</field>
        <field name="context">{'craf_tab': 'prognoz'}</field>
    </record>
    <record id="action_craf_litey_hujjat" model="ir.actions.client">
        <field name="name">Liteyka kirim-chiqim</field>
        <field name="tag">craf_litey</field>
        <field name="path">craf-litey-hujjat</field>
        <field name="context">{'craf_tab': 'hujjat'}</field>
    </record>

    <!-- Ishlab chiqarish → Liteyka bo'limi -->
    <menuitem id="menu_craf_litey" name="Liteyka sahifasi" parent="craf_production.menu_craf_bolim_litey"
              action="action_craf_litey" sequence="1"/>
    <menuitem id="menu_craf_litey_prognoz" name="Xom-ashyo qoldig'i va prognoz" parent="craf_production.menu_craf_bolim_litey"
              action="action_craf_litey_prognoz" sequence="5"/>
    <menuitem id="menu_craf_litey_hujjat" name="Kirim-chiqim hujjatlari" parent="craf_production.menu_craf_bolim_litey"
              action="action_craf_litey_hujjat" sequence="10"/>

    <!-- Liteyka → Sozlamalar -->
    <menuitem id="menu_craf_litey_config" name="Sozlamalar" parent="craf_production.menu_craf_bolim_litey"
              sequence="90" groups="stock.group_stock_manager"/>
    <menuitem id="menu_craf_litey_settings" name="Liteyka sozlamalari" parent="menu_craf_litey_config"
              action="action_craf_litey_settings" sequence="1"/>
    <menuitem id="menu_craf_litey_shifts" name="Smenalar" parent="menu_craf_litey_config"
              action="action_craf_litey_shift" sequence="5"/>

    <!-- Inventarizatsiya: Liteyka xom-ashyo qoldig'i shu yerda ham ko'rinadi -->
    <menuitem id="menu_craf_litey_prognoz_stock" name="Liteyka xom-ashyosi" parent="stock.menu_stock_inventory_control"
              action="action_craf_litey_prognoz" sequence="21"/>
    <menuitem id="menu_craf_litey_import" name="Excel qoldig'ini yuklash (Литейка)" parent="stock.menu_stock_adjustments"
              action="action_craf_litey_import" sequence="16" groups="stock.group_stock_manager"/>
</odoo>
