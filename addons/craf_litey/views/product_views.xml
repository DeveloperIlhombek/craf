<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_craf_litey" model="ir.ui.view">
        <field name="name">product.template.form.craf.litey</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="craf_profile.product_template_form_view_craf"/>
        <field name="arch" type="xml">
            <field name="craf_name_1c" position="after">
                <field name="craf_litey_name" invisible="craf_section_id"/>
                <field name="craf_litey_seq" invisible="craf_section_id"/>
                <field name="craf_melt_seq" invisible="craf_section_id"/>
                <field name="craf_litey_location_id" invisible="craf_section_id" options="{'no_create': True}"/>
                <field name="craf_not_metal" invisible="craf_section_id"/>
            </field>
        </field>
    </record>
</odoo>
