<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_activity_min_qty" model="mail.activity.type">
        <field name="name">Minimal qoldiq</field>
        <field name="summary">Xom-ashyo minimal qoldiqdan kam</field>
        <field name="icon">fa-exclamation-triangle</field>
        <field name="decoration_type">warning</field>
        <field name="res_model">product.template</field>
        <field name="delay_count">0</field>
    </record>

    <!-- Liteyka: minimal qoldiq eslatmalarini har soatda yangilash -->
    <record id="ir_cron_craf_litey_min_qty" model="ir.cron">
        <field name="name">Craf Liteyka: minimal qoldiq eslatmasi</field>
        <field name="model_id" ref="model_craf_litey_hisobot"/>
        <field name="state">code</field>
        <field name="code">model._cron_min_qty()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>
</odoo>
