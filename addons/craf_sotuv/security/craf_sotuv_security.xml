<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_craf" model="ir.module.category">
        <field name="name">Craf</field>
        <field name="sequence">4</field>
    </record>

    <record id="privilege_craf_sotuv" model="res.groups.privilege">
        <field name="name">Sotuv va yuklash</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_craf"/>
        <field name="description">Sotuvchi buyurtma oladi, yuklovchi yuklab «Berildi» qiladi.</field>
    </record>

    <record id="group_craf_loader" model="res.groups">
        <field name="name">Yuklovchi</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_craf_sotuv"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="comment">Yuklash navbatini ko'radi, mahsulotni yuklaydi va «Berildi» qiladi. Bosh sahifasi — Yuklash.</field>
    </record>

    <record id="group_craf_seller" model="res.groups">
        <field name="name">Sotuvchi</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_craf_sotuv"/>
        <field name="implied_ids" eval="[(4, ref('group_craf_loader')), (4, ref('sales_team.group_sale_salesman_all_leads')), (4, ref('base.group_partner_manager'))]"/>
        <field name="comment">Buyurtma oladi va yuklovchiga yuboradi; yuklovchining ishini ham qila oladi.</field>
    </record>

    <!-- sotuv rahbari (admin) — sotuvchi va yuklovchi ham -->
    <record id="sales_team.group_sale_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_craf_seller'))]"/>
    </record>
</odoo>
