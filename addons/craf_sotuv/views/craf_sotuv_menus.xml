<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_craf_sotuv" model="ir.actions.client">
        <field name="name">Sotuv</field>
        <field name="tag">craf_sotuv</field>
        <field name="path">craf-sotuv</field>
        <field name="context">{'craf_tab': 'new'}</field>
    </record>
    <record id="action_craf_yuklash" model="ir.actions.client">
        <field name="name">Yuklash</field>
        <field name="tag">craf_sotuv</field>
        <field name="path">craf-yuklash</field>
        <field name="context">{'craf_tab': 'load'}</field>
    </record>

    <!-- Sotish → Buyurtmalar: sotuvchi sahifasi va hujjatlar;
         Inventarizatsiya → Operatsiyalar: yuklovchi sahifasi (yuklovchi Sotish ilovasini ko'rmaydi). -->
    <menuitem id="menu_craf_sotuv" name="Yangi buyurtma (Craf)" parent="sale.sale_order_menu"
              action="action_craf_sotuv" sequence="1" groups="craf_sotuv.group_craf_seller"/>
    <menuitem id="menu_craf_sale_orders" name="Sotuv hujjatlari (Craf)" parent="sale.sale_order_menu"
              action="action_craf_sale_orders" sequence="25" groups="craf_sotuv.group_craf_seller"/>
    <menuitem id="menu_craf_sale_lines" name="Berilgan mahsulotlar" parent="sale.sale_order_menu"
              action="action_craf_sale_lines" sequence="26" groups="craf_sotuv.group_craf_seller"/>
    <menuitem id="menu_craf_yuklash" name="Yuklash" parent="stock.menu_stock_warehouse_mgmt"
              action="action_craf_yuklash" sequence="1" groups="craf_sotuv.group_craf_loader"/>
    <menuitem id="menu_craf_sotuv_alias" name="Sotuv qisqartmalari" parent="sale.menu_sale_config"
              action="action_craf_sotuv_alias" sequence="60"/>
    <menuitem id="menu_craf_sale_points" name="Sotuv joylari" parent="stock.menu_warehouse_config"
              action="action_craf_sale_points" sequence="60"/>
</odoo>
