<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_craf_telegram" model="ir.ui.view">
        <field name="name">res.config.settings.form.craf.telegram</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='mrp']" position="inside">
                <block title="Craf Telegram bot" name="craf_telegram_block">
                    <setting id="craf_tg_token" string="Bot tokeni"
                             help="Telegramda @BotFather → /newbot; bergan tokenni shu yerga yozing. Bitta bot hamma bo'limlar uchun.">
                        <field name="craf_tg_token" password="True" placeholder="123456789:AA..."/>
                        <div class="mt-2" invisible="not craf_tg_bot_username">
                            Bot: <b>@<field name="craf_tg_bot_username" class="d-inline"/></b>
                        </div>
                        <div class="mt-2">
                            <button name="action_craf_tg_check" type="object" string="Botni tekshirish" icon="fa-check" class="btn-link"/>
                            <button name="action_craf_tg_report_now" type="object" string="Kunlik hisobotni hozir yuborish" icon="fa-paper-plane" class="btn-link"/>
                        </div>
                    </setting>
                    <setting id="craf_tg_daily" string="Kunlik hisobot"
                             help="Har kuni shu soatda (Toshkent) kechagi kun hisoboti «Kunlik hisobot» belgilangan mas'ullarga yuboriladi.">
                        <field name="craf_tg_daily_hour"/> <span>:00</span>
                    </setting>
                    <setting id="craf_tg_contacts" string="Mas'ullar va Telegram ID"
                             help="Kishi botga /start bosadi — bot unga Telegram ID sini yozib beradi. ID bo'lim sozlamasiga yoziladi.">
                        <button name="%(craf_production.action_craf_bolim)d" type="action" string="Bo'limlar va mas'ullar" icon="fa-users" class="btn-link"/>
                        <button name="%(action_craf_telegram_log)d" type="action" string="Xabarlar jurnali" icon="fa-list" class="btn-link"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
