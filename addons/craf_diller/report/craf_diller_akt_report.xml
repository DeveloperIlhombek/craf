<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_akt" model="ir.actions.report">
        <field name="name">Akt sverka</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">craf_diller.report_akt</field>
        <field name="report_file">craf_diller.report_akt</field>
        <field name="paperformat_id" ref="craf_sotuv.paperformat_craf_waybill"/>
    </record>

    <template id="report_akt">
        <t t-call="web.html_container">
            <div class="page" style="font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #111;">
                <h3 style="margin: 0 0 4px;">Akt sverka (o'zaro hisob-kitob dalolatnomasi)</h3>
                <div><b t-esc="company.name"/> — <b t-esc="d['partner']['name']"/></div>
                <div style="margin-bottom: 10px;">Davr: <t t-esc="dmy(d['date_from'])"/> — <t t-esc="dmy(d['date_to'])"/></div>
                <table style="width: 100%; border-collapse: collapse;" border="1" cellpadding="4">
                    <thead>
                        <tr style="background: #e8e8e3;">
                            <th>Sana</th><th>Hujjat</th><th>Mazmuni</th>
                            <th style="text-align: right;">Berildi</th>
                            <th style="text-align: right;">To'landi</th>
                            <th style="text-align: right;">Qoldiq</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td t-esc="dmy(d['date_from'])"/><td/><td>Boshlang'ich qoldiq</td><td/><td/>
                            <td style="text-align: right;"><b t-esc="money(d['opening'])"/></td>
                        </tr>
                        <tr t-foreach="rows" t-as="r">
                            <td t-esc="dmy(r['date'])"/>
                            <td t-esc="r['name']"/>
                            <td t-esc="r['label']"/>
                            <td style="text-align: right;"><t t-if="r['amount'] &gt;= 0" t-esc="money(r['amount'])"/></td>
                            <td style="text-align: right;"><t t-if="r['amount'] &lt; 0" t-esc="money(-r['amount'])"/></td>
                            <td style="text-align: right;" t-esc="money(r['balance'])"/>
                        </tr>
                        <tr>
                            <td colspan="3"><b>Jami aylanma</b></td>
                            <td style="text-align: right;"><b t-esc="money(d['plus'])"/></td>
                            <td style="text-align: right;"><b t-esc="money(d['minus'])"/></td>
                            <td/>
                        </tr>
                        <tr>
                            <td colspan="5"><b>Oxirgi qoldiq, <t t-esc="d['currency']['symbol']"/></b></td>
                            <td style="text-align: right;"><b t-esc="money(d['closing'])"/></td>
                        </tr>
                    </tbody>
                </table>
                <div style="margin-top: 40px; display: table; width: 100%;">
                    <div style="display: table-cell; width: 50%;"><b t-esc="company.name"/><br/><br/>_____________________ (imzo)</div>
                    <div style="display: table-cell;"><b t-esc="d['partner']['name']"/><br/><br/>_____________________ (imzo)</div>
                </div>
            </div>
        </t>
    </template>
</odoo>
