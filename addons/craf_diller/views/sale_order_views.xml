<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_craf_diller" model="ir.ui.view">
        <field name="name">sale.order.form.craf.diller</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_craf_approve" type="object" string="Tasdiqlash" class="btn-primary" icon="fa-check"
                        invisible="not craf_portal or state not in ('draft', 'sent')" groups="craf_sotuv.group_craf_seller"/>
                <button name="action_craf_reject" type="object" string="Rad etish" icon="fa-times"
                        confirm="Buyurtma rad etiladi. Sababini oldin «Diller» varag'iga yozing. Davom etasizmi?"
                        invisible="not craf_portal or state not in ('draft', 'sent')" groups="craf_sotuv.group_craf_seller"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Diller" name="craf_diller" invisible="not craf_portal">
                    <group>
                        <group>
                            <field name="craf_portal" invisible="1"/>
                            <field name="craf_approval" widget="badge"/>
                            <field name="craf_diller_user_id"/>
                            <field name="craf_need_date"/>
                        </group>
                        <group>
                            <field name="craf_credit_note" invisible="not craf_credit_note"/>
                            <field name="craf_change_request" invisible="not craf_change_request"/>
                            <field name="craf_reject_note"/>
                            <field name="craf_approved_by" invisible="not craf_approved_by"/>
                            <field name="craf_approved_date" invisible="not craf_approved_date"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_craf_diller_order_list" model="ir.ui.view">
        <field name="name">sale.order.list.craf.diller</field>
        <field name="model">sale.order</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list default_order="id desc" create="0" decoration-danger="craf_approval == 'credit'"
                  decoration-muted="state == 'cancel'">
                <field name="state" column_invisible="1"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_order" string="Vaqt"/>
                <field name="craf_approval" widget="badge" decoration-danger="craf_approval == 'credit'"
                       decoration-info="craf_approval == 'submitted'" decoration-success="craf_approval == 'approved'"/>
                <field name="craf_load_state" optional="show"/>
                <field name="craf_location_id"/>
                <field name="craf_total_packs" string="Pachka"/>
                <field name="craf_total_kg" string="kg"/>
                <field name="amount_total" sum="Jami"/>
                <field name="craf_need_date" optional="show"/>
                <button name="action_craf_approve" type="object" string="Tasdiqlash" icon="fa-check" class="text-success"
                        invisible="state not in ('draft', 'sent')"/>
            </list>
        </field>
    </record>

    <record id="view_craf_diller_order_kanban" model="ir.ui.view">
        <field name="name">sale.order.kanban.craf.diller</field>
        <field name="model">sale.order</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <kanban create="0" class="o_kanban_mobile" default_order="id desc">
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="partner_id" class="fw-bold"/>
                            <field name="name"/>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span><field name="craf_total_packs"/> pachka · <field name="amount_total"/></span>
                            <field name="craf_approval" widget="badge"/>
                        </div>
                        <div class="mt-1">
                            <field name="state" invisible="1"/>
                            <button name="action_craf_approve" type="object" class="btn btn-primary btn-sm"
                                    invisible="state not in ('draft', 'sent')">Tasdiqlash</button>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_craf_diller_order_search" model="ir.ui.view">
        <field name="name">sale.order.search.craf.diller</field>
        <field name="model">sale.order</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="waiting" string="Tasdiq kutmoqda" domain="[('state', 'in', ('draft', 'sent'))]"/>
                <filter name="credit" string="Qarz bo'yicha" domain="[('craf_approval', '=', 'credit')]"/>
            </search>
        </field>
    </record>

    <record id="action_craf_diller_orders" model="ir.actions.act_window">
        <field name="name">Diller buyurtmalari</field>
        <field name="res_model">sale.order</field>
        <field name="path">craf-diller-buyurtmalar</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('craf_portal', '=', True)]</field>
        <field name="context">{'search_default_waiting': 1}</field>
        <field name="search_view_id" ref="view_craf_diller_order_search"/>
    </record>
    <record id="action_craf_diller_orders_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_craf_diller_order_list"/>
        <field name="act_window_id" ref="action_craf_diller_orders"/>
    </record>
    <record id="action_craf_diller_orders_kanban" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_craf_diller_order_kanban"/>
        <field name="act_window_id" ref="action_craf_diller_orders"/>
    </record>
</odoo>
