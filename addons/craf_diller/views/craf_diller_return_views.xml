<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_craf_diller_return_list" model="ir.ui.view">
        <field name="name">craf.diller.return.list</field>
        <field name="model">craf.diller.return</field>
        <field name="arch" type="xml">
            <list create="0" decoration-info="state == 'new'" decoration-warning="state == 'approved'"
                  decoration-muted="state == 'rejected'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="order_id"/>
                <field name="reason"/>
                <field name="location_id"/>
                <field name="state" widget="badge"/>
                <field name="create_date" string="Vaqt"/>
            </list>
        </field>
    </record>

    <record id="view_craf_diller_return_form" model="ir.ui.view">
        <field name="name">craf.diller.return.form</field>
        <field name="model">craf.diller.return</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_approve" type="object" string="Tasdiqlash" class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_receive" type="object" string="Mahsulot keldi — kirim" class="btn-primary"
                            invisible="state != 'approved'"
                            confirm="Mahsulot omborga kirim qilinadi va qarz kamayadi. Davom etasizmi?"/>
                    <button name="action_reject" type="object" string="Rad etish" invisible="state not in ('new', 'approved')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="order_id"/>
                            <field name="user_id"/>
                            <field name="reason"/>
                            <field name="note"/>
                        </group>
                        <group>
                            <field name="location_id" options="{'no_create': True}" readonly="state in ('done', 'rejected')"/>
                            <field name="reject_note" readonly="state in ('done', 'rejected')"/>
                            <field name="picking_id" invisible="not picking_id"/>
                            <field name="photo_ids" widget="many2many_binary" invisible="not photo_ids"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="product_id"/>
                            <field name="qty_text"/>
                            <field name="qty"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_craf_diller_returns" model="ir.actions.act_window">
        <field name="name">Qaytarish so'rovlari</field>
        <field name="res_model">craf.diller.return</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
