<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_craf_mrp" model="ir.ui.view">
        <field name="name">product.template.form.craf.mrp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Bosqichlar va sarf" name="craf_mrp" invisible="not craf_bom_id">
                    <field name="craf_bom_id" invisible="1"/>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <button name="action_craf_new_mo" type="object" string="Ishlab chiqarish buyurtmasi"
                                class="btn-primary" icon="fa-plus"/>
                        <button name="action_craf_bom_overview" type="object" string="BoM tuzilmasi"
                                class="btn-secondary" icon="fa-sitemap"/>
                        <button name="action_craf_open_bom" type="object" string="BoM ni ochish"
                                class="btn-secondary" icon="fa-flask"/>
                    </div>
                    <h5>Ishlab chiqarish bosqichlari</h5>
                    <field name="craf_stages_html" nolabel="1" readonly="1"/>
                    <h5 class="mt-4">Jami xom-ashyo sarfi</h5>
                    <field name="craf_consumption_html" nolabel="1" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
