<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="craf_zavod_transfer_view_form" model="ir.ui.view">
        <field name="name">craf.zavod.transfer.form</field>
        <field name="model">craf.zavod.transfer</field>
        <field name="arch" type="xml">
            <form string="Ko'chirish">
                <group>
                    <group string="Qayerdan → qayerga">
                        <field name="location_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="location_dest_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="available_product_ids" invisible="1"/>
                    </group>
                    <group string="Mahsulot">
                        <field name="product_id" options="{'no_create': True}"/>
                        <field name="available_text" invisible="not product_id"/>
                        <field name="pcs_per_pack" invisible="1"/>
                        <field name="available_qty" invisible="1"/>
                    </group>
                </group>
                <group string="Qancha" invisible="not product_id">
                    <group>
                        <field name="qty_packs" invisible="not pcs_per_pack"/>
                        <field name="qty_extra" invisible="not pcs_per_pack"/>
                        <label for="quantity"/>
                        <div class="o_row">
                            <field name="quantity" class="oe_inline"/>
                            <field name="uom_id" readonly="1" options="{'no_open': True}" class="oe_inline"/>
                        </div>
                    </group>
                    <group>
                        <field name="summary" readonly="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Ko'chirish" class="btn-primary"
                            icon="fa-exchange"/>
                    <button string="Bekor qilish" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
