<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_craf_kunlik" model="ir.actions.client">
        <field name="name">Kunlik hisobot</field>
        <field name="tag">craf_kunlik</field>
        <field name="path">craf-kunlik</field>
    </record>
    <menuitem id="menu_craf_kunlik" name="Kunlik hisobot" parent="stock.menu_warehouse_report"
              action="action_craf_kunlik" sequence="1"/>

    <record id="craf_foundry_melt_view_list_c1" model="ir.ui.view">
        <field name="name">craf.foundry.melt.list.c1</field>
        <field name="model">craf.foundry.melt</field>
        <field name="inherit_id" ref="craf_foundry.craf_foundry_melt_view_list"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="c1_state" widget="badge" optional="show" string="1C"
                       decoration-success="c1_state == 'done'" decoration-warning="c1_state == 'new' and state == 'done'"/>
            </field>
        </field>
    </record>
    <record id="craf_foundry_melt_view_search_c1" model="ir.ui.view">
        <field name="name">craf.foundry.melt.search.c1</field>
        <field name="model">craf.foundry.melt</field>
        <field name="inherit_id" ref="craf_foundry.craf_foundry_melt_view_search"/>
        <field name="arch" type="xml">
            <filter name="done" position="after">
                <filter name="c1_new" string="1C ga kiritilmagan" domain="[('state', '=', 'done'), ('c1_state', '=', 'new')]"/>
            </filter>
        </field>
    </record>
    <record id="craf_foundry_melt_view_form_c1" model="ir.ui.view">
        <field name="name">craf.foundry.melt.form.c1</field>
        <field name="model">craf.foundry.melt</field>
        <field name="inherit_id" ref="craf_foundry.craf_foundry_melt_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="inside">
                <span class="badge text-bg-success" invisible="c1_state != 'done'">1C ga kiritildi</span>
                <span class="badge text-bg-warning" invisible="c1_state != 'new' or state != 'done'">1C ga kiritilmagan</span>
                <field name="c1_state" invisible="1"/>
            </xpath>
        </field>
    </record>

