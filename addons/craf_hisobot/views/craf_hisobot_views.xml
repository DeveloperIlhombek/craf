    <record id="product_template_list_view_craf_materials_min" model="ir.ui.view">
        <field name="name">product.template.list.craf.materials.min</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="craf_profile.product_template_list_view_craf_materials"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="editable">bottom</attribute>
                <attribute name="create">false</attribute>
            </xpath>
            <field name="default_code" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="name" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="qty_available" position="after">
                <field name="craf_min_qty"/>
            </field>
            <field name="uom_id" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
        </field>
    </record>

    <record id="product_template_form_view_craf_min" model="ir.ui.view">
        <field name="name">product.template.form.craf.min</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="craf_profile.product_template_form_view_craf"/>
        <field name="arch" type="xml">
            <field name="craf_name_1c" position="after">
                <field name="craf_min_qty"/>
            </field>
        </field>
    </record>
