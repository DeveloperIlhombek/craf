<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_craf_label" model="report.paperformat">
        <field name="name">Craf pachka yorlig'i 100 × 75 mm</field>
        <field name="format">custom</field>
        <field name="page_width">100</field>
        <field name="page_height">75</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">2</field>
        <field name="margin_left">3</field>
        <field name="margin_right">3</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_craf_pack" model="ir.actions.report">
        <field name="name">Pachka yorlig'i</field>
        <field name="model">craf.pack</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">craf_label.report_craf_pack</field>
        <field name="report_file">craf_label.report_craf_pack</field>
        <field name="print_report_name">'Yorliq - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_craf_label"/>
        <field name="binding_model_id" ref="model_craf_pack"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_craf_pack_document">
        <div class="page" style="font-family: Arial, Helvetica, sans-serif; color: #000;">
            <table style="width: 100%; border-collapse: collapse; border: 2px solid #000;">
                <tr>
                    <td colspan="2" style="padding: 3px 6px; border-bottom: 2px solid #000;">
                        <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)"
                             style="height: 17px; max-width: 120px; vertical-align: middle;" alt="Logo"/>
                        <span t-else="" style="font-size: 15px; font-weight: bold; letter-spacing: 2px;">CRAF</span>
                        <span style="float: right; font-size: 15px; font-weight: bold;" t-esc="o.name"/>
                    </td>
                </tr>
                <tr>
                    <td colspan="2" style="padding: 4px 6px 0 6px; font-size: 17px; font-weight: bold; line-height: 1.15;"
                        t-esc="o.product_id.name"/>
                </tr>
                <tr>
                    <td colspan="2" style="padding: 0 6px 3px 6px; font-size: 11px;" t-esc="o.default_code or ''"/>
                </tr>
                <tr>
                    <td style="width: 62%; vertical-align: top; padding: 2px 6px;">
                        <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                            <tr>
                                <td style="padding: 1px 0; width: 42%;">Kesim</td>
                                <td style="padding: 1px 0; font-weight: bold;" t-esc="o.section_id.name or '—'"/>
                            </tr>
                            <tr>
                                <td style="padding: 1px 0;">Rang</td>
                                <td style="padding: 1px 0; font-weight: bold;" t-esc="o.color_id.name or '—'"/>
                            </tr>
                            <tr>
                                <td style="padding: 1px 0;">Uzunlik</td>
                                <td style="padding: 1px 0; font-weight: bold;" t-esc="('%g m' % o.length_m) if o.length_m else '—'"/>
                            </tr>
                            <tr>
                                <td style="padding: 2px 0;">Dona</td>
                                <td style="padding: 2px 0; font-size: 17px; font-weight: bold;" t-esc="'%s шт' % o.pcs"/>
                            </tr>
                            <tr>
                                <td style="padding: 1px 0;">Nazariy</td>
                                <td style="padding: 1px 0; font-weight: bold;"
                                    t-esc="(('%.2f' % o.kg_theory).replace('.', ',') + ' kg') if o.kg_theory else '—'"/>
                            </tr>
                            <tr>
                                <td style="padding: 3px 0 1px 0;">Haqiqiy</td>
                                <td style="padding: 3px 0 1px 0; font-weight: bold;">
                                    <t t-if="o.kg_actual" t-esc="('%.2f' % o.kg_actual).replace('.', ',') + ' kg'"/>
                                    <t t-else="">________ kg</t>
                                </td>
                            </tr>
                        </table>
                    </td>
                    <td style="width: 38%; vertical-align: middle; text-align: center; padding: 2px;">
                        <span t-field="o.qr_value"
                              t-options="{'widget': 'barcode', 'symbology': 'QR', 'width': 300, 'height': 300, 'quiet': 0, 'img_style': 'width: 31mm; height: 31mm;'}"/>
                    </td>
                </tr>
                <tr>
                    <td colspan="2" style="border-top: 1px solid #000; padding: 3px 6px; font-size: 10px;">
                        <span t-field="o.date" t-options="{'widget': 'date'}"/>
                        <t t-if="o.origin"> · <t t-esc="o.origin"/></t>
                        <t t-if="o.user_id"> · <t t-esc="o.user_id.name"/></t>
                    </td>
                </tr>
            </table>
        </div>
    </template>

    <template id="report_craf_pack">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-call="craf_label.report_craf_pack_document"/>
                </t>
            </t>
        </t>
    </template>
</odoo>
