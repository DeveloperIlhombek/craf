<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="craf_briket_view_list" model="ir.ui.view">
        <field name="name">craf.briket.list</field>
        <field name="model">craf.briket</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="date"/>
                <field name="shift" optional="show"/>
                <field name="input_product_id"/>
                <field name="input_qty" sum="Jami"/>
                <field name="product_id"/>
                <field name="qty" sum="Jami"/>
                <field name="loss_qty" sum="Jami" optional="show"/>
                <field name="employee_id" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="craf_briket_view_form" model="ir.ui.view">
        <field name="name">craf.briket.form</field>
        <field name="model">craf.briket</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" type="object" string="Tasdiqlash" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Bekor qilish" invisible="state != 'draft'"/>
                    <button name="action_draft" type="object" string="Qoralamaga" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_productions" type="object" class="oe_stat_button" icon="fa-cogs"
                                invisible="production_count == 0">
                            <field name="production_count" widget="statinfo" string="Buyurtma"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Brak profil → briket">
                            <field name="input_product_id" readonly="state != 'draft'"/>
                            <field name="input_available"/>
                            <field name="input_qty" readonly="state != 'draft'"/>
                            <field name="product_id" readonly="state != 'draft'"/>
                            <field name="qty" readonly="state != 'draft'" class="fw-bold"/>
                            <field name="loss_qty"/>
                        </group>
                        <group string="Hujjat">
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="shift" readonly="state != 'draft'"/>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="location_src_id" readonly="state != 'draft'"/>
                            <field name="location_dest_id" readonly="state != 'draft'"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Izoh"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

        <!-- Telefon uchun kartochka ko'rinishi (mobile-first) -->
    <record id="craf_briket_view_kanban" model="ir.ui.view">
        <field name="name">craf.briket.kanban.mobile</field>
        <field name="model">craf.briket</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates><t t-name="card">
                    <div class="d-flex align-items-center gap-2">
                        <field name="name" class="fw-bold text-truncate"/>
                        <field name="state" widget="badge" class="ms-auto" decoration-success="state == 'done'" decoration-info="state == 'draft'"/>
                    </div>
                    <div class="d-flex flex-wrap gap-2 text-muted small"><field name="date"/> <field name="product_id"/></div>
                    <div class="d-flex flex-wrap gap-3 mt-1"><span><span class="text-muted small">Brak: </span><field name="input_qty" class="fw-bold"/></span> <span><span class="text-muted small">Briket: </span><field name="qty" class="fw-bold"/></span> <span><span class="text-muted small">Yo'qotish: </span><field name="loss_qty" class="fw-bold"/></span></div>
                </t></templates>
            </kanban>
        </field>
    </record>

    <record id="action_craf_briket" model="ir.actions.act_window">
        <field name="name">Briketlash</field>
        <field name="res_model">craf.briket</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Briketlash hujjati</p>
            <p>Yaroqsiz (brak) profil presslab, zichlab briket qilinadi: brak Chiqindi dan sarflanadi,
               briket Chiqindi ga kiradi va Литейка da qayta eritiladi.</p>
        </field>
    </record>
</odoo>
