<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="craf_press_smena_view_list" model="ir.ui.view">
        <field name="name">craf.press.smena.list</field>
        <field name="model">craf.press.smena</field>
        <field name="arch" type="xml">
            <list string="Smenalar">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="time_text"/>
                <field name="equipment_id"/>
                <field name="responsible_id" widget="many2one_avatar_employee"/>
                <field name="worker_ids" widget="many2many_avatar_employee" optional="show"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="craf_press_smena_view_kanban" model="ir.ui.view">
        <field name="name">craf.press.smena.kanban</field>
        <field name="model">craf.press.smena</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-baseline">
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="time_text" class="ms-auto text-muted"/>
                        </div>
                        <div class="small"><field name="equipment_id"/></div>
                        <div class="mt-1"><span class="text-muted small">Mas'ul: </span><field name="responsible_id"/></div>
                        <footer class="pt-1">
                            <field name="worker_ids" widget="many2many_avatar_employee"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="craf_press_smena_view_form" model="ir.ui.view">
        <field name="name">craf.press.smena.form</field>
        <field name="model">craf.press.smena</field>
        <field name="arch" type="xml">
            <form string="Smena">
                <sheet>
                    <widget name="web_ribbon" title="Arxiv" bg_color="text-bg-secondary" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="masalan: Kunduzgi smena"/></h1>
                    </div>
                    <group>
                        <group string="Ish vaqti va press">
                            <label for="time_from" string="Ish vaqti"/>
                            <div class="o_row">
                                <field name="time_from" widget="float_time" class="oe_inline"/>
                                <span>–</span>
                                <field name="time_to" widget="float_time" class="oe_inline"/>
                                <span class="text-muted">(<field name="duration" widget="float_time" class="oe_inline"/> soat)</span>
                            </div>
                            <field name="equipment_id" options="{'no_create': True}" placeholder="Press №1 yoki Press №2"/>
                        </group>
                        <group string="Xodimlar">
                            <field name="responsible_id" widget="many2one_avatar_employee"/>
                            <field name="worker_ids" widget="many2many_tags_avatar" placeholder="ixtiyoriy"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Izoh…"/>
                    <field name="active" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_craf_press_smena" model="ir.actions.act_window">
        <field name="name">Smenalar</field>
        <field name="res_model">craf.press.smena</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Press smenalarini kiriting</p>
            <p>Smena nomi, ish vaqti (masalan, 08:00–20:00), press, mas'ul va ishchilar — bir marta kiritiladi.
                Mas'ul va ishchilar Xodimlar ro'yxatidan tanlanadi.</p>
        </field>
    </record>
</odoo>
