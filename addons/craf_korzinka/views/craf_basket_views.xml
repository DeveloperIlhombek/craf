<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Korzinka (jismoniy). Ro'yxat va kartochka tepasida kichik dashboard (js_class craf_basket_*). -->
    <record id="craf_basket_view_list" model="ir.ui.view">
        <field name="name">craf.basket.list</field>
        <field name="model">craf.basket</field>
        <field name="arch" type="xml">
            <list string="Korzinkalar" editable="bottom" js_class="craf_basket_list"
                  decoration-muted="state == 'empty'" decoration-warning="is_stale"
                  decoration-danger="state == 'broken'">
                <header>
                    <button name="action_release" type="object" string="Bo'shatish" icon="fa-undo"
                            confirm="Tanlangan korzinkalar bo'sh qaytdi (profillari bo'yash va qadoqlashdan o'tgan) deb belgilanadi. Davom etasizmi?"/>
                    <button name="action_mark_broken" type="object" string="Yaroqsiz" icon="fa-ban"/>
                    <button name="action_mark_ok" type="object" string="Yaroqli" icon="fa-check"/>
                </header>
                <field name="name"/>
                <field name="state" widget="badge" decoration-warning="state in ('press', 'kimyo')"
                       decoration-danger="state == 'broken'" decoration-muted="state == 'empty'"/>
                <field name="content"/>
                <field name="pcs" sum="Jami"/>
                <field name="kg" sum="Jami"/>
                <field name="loaded_date" optional="show"/>
                <field name="days_full" optional="show" decoration-danger="is_stale"/>
                <field name="load_count" optional="show"/>
                <field name="cycle_days" optional="show"/>
                <field name="tare_kg" optional="show"/>
                <field name="capacity" optional="hide"/>
                <field name="broken_note" optional="hide"/>
                <field name="is_stale" column_invisible="1"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="craf_basket_view_kanban" model="ir.ui.view">
        <field name="name">craf.basket.kanban</field>
        <field name="model">craf.basket</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" js_class="craf_basket_kanban">
                <field name="state"/>
                <field name="is_stale"/>
                <field name="days_full"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center">
                            <field name="name" class="fw-bold fs-5"/>
                            <span class="ms-auto badge"
                                  t-att-class="record.state.raw_value === 'broken' ? 'text-bg-danger' : (record.state.raw_value === 'empty' ? 'text-bg-light' : (record.is_stale.raw_value ? 'text-bg-warning' : 'text-bg-info'))">
                                <field name="state"/>
                            </span>
                        </div>
                        <field name="content" class="text-muted small"/>
                        <div class="d-flex mt-1" t-if="record.state.raw_value === 'press' or record.state.raw_value === 'kimyo'">
                            <span><field name="pcs"/> dona · <field name="kg"/> kg</span>
                            <span class="ms-auto small" t-att-class="record.is_stale.raw_value ? 'text-danger fw-bold' : 'text-muted'">
                                <field name="days_full"/> kun
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="craf_basket_view_form" model="ir.ui.view">
        <field name="name">craf.basket.form</field>
        <field name="model">craf.basket</field>
        <field name="arch" type="xml">
            <form string="Korzinka">
                <header>
                    <button name="action_release" type="object" string="Bo'shatish" icon="fa-undo"
                            invisible="state not in ('press', 'kimyo')"
                            confirm="Korzinka bo'sh qaytdi (profillari bo'yash va qadoqlashdan o'tgan) deb belgilanadi. Davom etasizmi?"/>
                    <button name="action_mark_broken" type="object" string="Yaroqsiz deb belgilash" icon="fa-ban"
                            invisible="broken or state in ('press', 'kimyo')"/>
                    <button name="action_mark_ok" type="object" string="Yaroqli" icon="fa-check" class="btn-primary"
                            invisible="not broken"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_loads" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="load_count" widget="statinfo" string="Aylanish"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Yaroqsiz" bg_color="text-bg-danger" invisible="not broken"/>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="tare_kg"/>
                            <field name="capacity"/>
                            <field name="note"/>
                            <field name="broken" invisible="1"/>
                            <field name="broken_date" invisible="not broken"/>
                            <field name="broken_note" invisible="not broken" placeholder="masalan: tagi singan"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Hozir">
                            <field name="state"/>
                            <field name="content"/>
                            <field name="pcs"/>
                            <field name="kg"/>
                            <field name="loaded_date"/>
                            <field name="days_full"/>
                            <field name="cycle_days"/>
                            <field name="current_load_id"/>
                            <field name="is_stale" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="craf_basket_view_search" model="ir.ui.view">
        <field name="name">craf.basket.search</field>
        <field name="model">craf.basket</field>
        <field name="arch" type="xml">
            <search string="Korzinkalar">
                <field name="name"/>
                <filter name="empty" string="Bo'sh" domain="[('state', '=', 'empty')]"/>
                <filter name="filled" string="To'la" domain="[('state', 'in', ('press', 'kimyo'))]"/>
                <filter name="stale" string="Uzoq turgan" domain="[('is_stale', '=', True)]"/>
                <filter name="broken" string="Yaroqsiz" domain="[('broken', '=', True)]"/>
                <separator/>
                <filter name="archived" string="Arxiv" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_craf_basket" model="ir.actions.act_window">
        <field name="name">Korzinkalar</field>
        <field name="res_model">craf.basket</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="path">craf-korzinkalar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Korzinkalarni kiriting</p>
            <p>Har bir korzinkaning kodi va bo'sh og'irligi (tara). Sig'imi odatda 120 dona.</p>
        </field>
    </record>

    <!-- Korzinka yuklari -->
    <record id="craf_basket_load_view_list" model="ir.ui.view">
        <field name="name">craf.basket.load.list</field>
        <field name="model">craf.basket.load</field>
        <field name="arch" type="xml">
            <list string="Korzinka yuklari" create="false">
                <field name="date"/>
                <field name="basket_id"/>
                <field name="shift_id"/>
                <field name="content"/>
                <field name="pcs_total" sum="Jami"/>
                <field name="kg_theory" sum="Jami"/>
                <field name="net_kg" sum="Jami" optional="show"/>
                <field name="kg_diff" optional="hide"/>
                <field name="defect_pcs" sum="Jami" optional="show"/>
                <field name="cut_pcs" sum="Jami" optional="hide"/>
                <field name="defect_kg" sum="Jami" optional="show"/>
                <field name="state" widget="badge" decoration-warning="state == 'press'"
                       decoration-success="state == 'kimyo'" decoration-muted="state == 'boyash'"/>
                <field name="location_id" optional="show"/>
                <field name="returned_date" optional="show"/>
                <field name="treatment_id" optional="hide"/>
                <field name="paint_batch_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="craf_basket_load_view_form" model="ir.ui.view">
        <field name="name">craf.basket.load.form</field>
        <field name="model">craf.basket.load</field>
        <field name="arch" type="xml">
            <form string="Korzinka yuki" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="basket_id"/>
                            <field name="shift_id"/>
                            <field name="date"/>
                            <field name="section_id"/>
                            <field name="state"/>
                            <field name="location_id"/>
                        </group>
                        <group>
                            <field name="piece_kg"/>
                            <field name="qty_6"/>
                            <field name="qty_5"/>
                            <field name="pcs_total"/>
                            <field name="kg_theory"/>
                        </group>
                        <group string="Og'irlik">
                            <field name="tare_kg"/>
                            <field name="hook_kg"/>
                            <field name="stick_kg"/>
                            <field name="gross_kg"/>
                            <field name="net_kg"/>
                            <field name="kg_diff"/>
                        </group>
                        <group string="Bo'yashda ajratilgan" invisible="not defect_pcs and not cut_pcs">
                            <field name="defect_pcs"/>
                            <field name="cut_pcs"/>
                            <field name="defect_kg"/>
                            <field name="left_text"/>
                        </group>
                        <group>
                            <field name="treatment_id"/>
                            <field name="paint_batch_id"/>
                        </group>
                    </group>
                    <field name="extra_line_ids" invisible="not extra_line_ids" readonly="1">
                        <list>
                            <field name="section_id"/>
                            <field name="piece_kg"/>
                            <field name="qty_6"/>
                            <field name="qty_5"/>
                            <field name="kg_theory"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="craf_basket_load_view_search" model="ir.ui.view">
        <field name="name">craf.basket.load.search</field>
        <field name="model">craf.basket.load</field>
        <field name="arch" type="xml">
            <search string="Korzinka yuklari">
                <field name="basket_id"/>
                <field name="shift_id"/>
                <field name="section_id"/>
                <filter name="today" string="Bugun" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="active_loads" string="Bo'yashda" domain="[('state', 'in', ('press', 'kimyo'))]"/>
                <filter name="returned" string="Qaytgan" domain="[('state', '=', 'boyash')]"/>
                <group>
                    <filter name="group_date" string="Sana" context="{'group_by': 'date:day'}"/>
                    <filter name="group_section" string="Profil" context="{'group_by': 'section_id'}"/>
                    <filter name="group_state" string="Holati" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_craf_basket_load" model="ir.actions.act_window">
        <field name="name">Korzinka yuklari</field>
        <field name="res_model">craf.basket.load</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_date': 1}</field>
    </record>
</odoo>
