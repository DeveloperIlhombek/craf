<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="craf_extrusion_shift_view_form_korzinka" model="ir.ui.view">
        <field name="name">craf.extrusion.shift.form.korzinka</field>
        <field name="model">craf.extrusion.shift</field>
        <field name="inherit_id" ref="craf_extrusion.craf_extrusion_shift_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_done']" position="after">
                <button name="action_fill_from_baskets" type="object" string="Korzinkalardan to'ldirish"
                        icon="fa-shopping-basket" invisible="state != 'draft' or not basket_load_ids"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_baskets" type="object" class="oe_stat_button" icon="fa-shopping-basket"
                        invisible="not basket_count">
                    <field name="basket_count" widget="statinfo" string="Korzinka"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='output']" position="attributes">
                <attribute name="string">Chiqish (avtomatik)</attribute>
            </xpath>
            <xpath expr="//page[@name='output']" position="before">
                <page string="Korzinkalar" name="baskets">
                    <div class="text-muted small mb-2">
                        Press varag'idagi kabi: korzinka, profil (6 m / 5 m dona), kerak bo'lsa ikkinchi profil,
                        kryuchok, palka va brutto. Netto = brutto − korzinka − kryuchok − palka.
                    </div>
                    <field name="basket_load_ids" readonly="state != 'draft'"
                           context="{'default_section_id': section_id}">
                        <list editable="bottom">
                            <field name="basket_id" options="{'no_create_edit': True}"/>
                            <field name="tare_kg" sum="Jami"/>
                            <field name="section_id" options="{'no_create': True}"/>
                            <field name="qty_6" sum="Jami" string="6 m"/>
                            <field name="qty_5" sum="Jami" string="5 m"/>
                            <field name="section2_id" options="{'no_create': True}" optional="show"/>
                            <field name="qty2_6" sum="Jami" string="+6 m" optional="show"/>
                            <field name="qty2_5" sum="Jami" string="+5 m" optional="show"/>
                            <field name="hook_kg" sum="Jami" string="Kryuchok"/>
                            <field name="stick_kg" sum="Jami" string="Palka"/>
                            <field name="gross_kg" sum="Jami" string="Brutto"/>
                            <field name="net_kg" sum="Jami" string="Netto"/>
                            <field name="kg_theory" sum="Jami" string="Nazariy" optional="show"/>
                            <field name="kg_diff" string="Farq" optional="hide"
                                   decoration-danger="kg_diff &lt; -15 or kg_diff &gt; 15"/>
                            <field name="state" optional="hide"/>
                        </list>
                        <kanban class="o_kanban_mobile">
                            <templates>
                                <t t-name="card">
                                    <div class="d-flex align-items-center">
                                        <span class="fw-bold fs-5"><field name="basket_id"/></span>
                                        <span class="ms-2 text-muted small"><field name="tare_kg"/> kg</span>
                                        <span class="ms-auto">netto <field name="net_kg" class="fw-bold"/> kg</span>
                                    </div>
                                    <div class="small"><field name="content"/></div>
                                    <div class="text-muted small">
                                        brutto <field name="gross_kg"/> · kryuchok <field name="hook_kg"/> · palka <field name="stick_kg"/>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                        <form string="Korzinka">
                            <group>
                                <group string="Korzinka">
                                    <field name="basket_id" options="{'no_create_edit': True}"/>
                                    <field name="tare_kg"/>
                                    <field name="hook_kg"/>
                                    <field name="stick_kg"/>
                                    <field name="gross_kg"/>
                                    <field name="net_kg"/>
                                </group>
                                <group string="Profil">
                                    <field name="section_id" options="{'no_create': True}"/>
                                    <field name="qty_6"/>
                                    <field name="qty_5"/>
                                    <field name="section2_id" options="{'no_create': True}"/>
                                    <field name="qty2_6" invisible="not section2_id"/>
                                    <field name="qty2_5" invisible="not section2_id"/>
                                    <field name="pcs_total"/>
                                    <field name="kg_theory"/>
                                </group>
                            </group>
                        </form>
                    </field>
                    <group class="mt-2">
                        <group string="Jami">
                            <field name="basket_pcs"/>
                            <field name="basket_gross_kg"/>
                            <field name="basket_net_kg" class="fw-bold"/>
                            <field name="basket_theory_kg"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="craf_extrusion_shift_view_list_korzinka" model="ir.ui.view">
        <field name="name">craf.extrusion.shift.list.korzinka</field>
        <field name="model">craf.extrusion.shift</field>
        <field name="inherit_id" ref="craf_extrusion.craf_extrusion_shift_view_list"/>
        <field name="arch" type="xml">
            <field name="output_pcs" position="before">
                <field name="basket_count" sum="Jami" string="Korzinka"/>
                <field name="basket_net_kg" sum="Jami" string="Netto, kg"/>
            </field>
        </field>
    </record>
</odoo>
