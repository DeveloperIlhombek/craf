<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="craf_extrusion_shift_view_form_korzinka" model="ir.ui.view">
        <field name="name">craf.extrusion.shift.form.korzinka</field>
        <field name="model">craf.extrusion.shift</field>
        <field name="inherit_id" ref="craf_extrusion.craf_extrusion_shift_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_baskets" type="object" class="oe_stat_button" icon="fa-shopping-basket"
                        invisible="not basket_count">
                    <field name="basket_count" widget="statinfo" string="Korzinka"/>
                </button>
            </xpath>
            <xpath expr="//div[@name='baskets']" position="inside">
                <div class="o_horizontal_separator mt-3 mb-1 fw-bold">Korzinkalar</div>
                <div class="text-muted small mb-2">
                    «Qator qo'shish» — korzinka oynasi ochiladi: korzinka, profil (bitta korzinkaga 2-3 xil bo'lishi
                    mumkin), brutto. Profil, 1 dona kg, kryuchok va palka oldingi korzinkadan o'zi tushadi.
                    «Saqlash va yangi» bilan keyingi korzinkaga o'tiladi.
                </div>
                <!-- oxirgi korzinkadan yangi korzinkaga boshlang'ich qiymatlar -->
                <field name="last_section_id" invisible="1"/>
                <field name="last_piece_kg" invisible="1"/>
                <field name="last_hook_kg" invisible="1"/>
                <field name="last_stick_kg" invisible="1"/>
                <field name="basket_load_ids" readonly="state != 'draft'"
                       context="{'default_section_id': last_section_id, 'default_piece_kg': last_piece_kg,
                                 'default_hook_kg': last_hook_kg, 'default_stick_kg': last_stick_kg}">
                    <list>
                        <field name="basket_id"/>
                        <field name="tare_kg" string="Korzinka, kg" optional="show"/>
                        <field name="content" string="Ichida"/>
                        <field name="pcs_total" sum="Jami" string="Dona"/>
                        <field name="gross_kg" sum="Jami" string="Brutto"/>
                        <field name="net_kg" sum="Jami" string="Netto"/>
                        <field name="kg_theory" sum="Jami" string="Nazariy" optional="hide"/>
                    </list>
                    <kanban class="o_kanban_mobile">
                        <templates>
                            <t t-name="card">
                                <div class="d-flex align-items-center">
                                    <span class="fw-bold fs-5"><field name="basket_id"/></span>
                                    <span class="ms-2 text-muted small"><field name="tare_kg"/> kg</span>
                                    <span class="ms-auto">netto <field name="net_kg" class="fw-bold"/> kg</span>
                                </div>
                                <div class="small"><field name="content"/></div>
                                <div class="text-muted small">
                                    <field name="pcs_total"/> dona · brutto <field name="gross_kg"/> kg
                                </div>
                            </t>
                        </templates>
                    </kanban>
                    <form string="Korzinka">
                        <field name="shift_id" invisible="1"/>
                        <group>
                            <group string="Korzinka">
                                <field name="basket_id" options="{'no_create_edit': True}"
                                       placeholder="korzinka raqami"/>
                                <field name="tare_kg"/>
                            </group>
                            <group string="Og'irlik">
                                <field name="gross_kg" class="fw-bold"/>
                                <field name="hook_kg"/>
                                <field name="stick_kg"/>
                                <field name="net_kg" class="fw-bold"/>
                            </group>
                        </group>
                        <group string="Profil">
                            <group>
                                <field name="section_id" options="{'no_create': True}"/>
                                <field name="piece_kg"/>
                            </group>
                            <group>
                                <field name="qty_6"/>
                                <field name="qty_5"/>
                            </group>
                        </group>
                        <div class="o_horizontal_separator mb-1">Qo'shimcha profillar (shu korzinkada boshqa profil bo'lsa)</div>
                        <field name="extra_line_ids">
                            <list editable="bottom">
                                <field name="section_id" options="{'no_create': True}"/>
                                <field name="piece_kg"/>
                                <field name="qty_6" string="6 m"/>
                                <field name="qty_5" string="5 m"/>
                                <field name="kg_theory" string="Nazariy kg" optional="hide"/>
                            </list>
                        </field>
                        <group>
                            <group>
                                <field name="pcs_total"/>
                                <field name="kg_theory"/>
                            </group>
                        </group>
                    </form>
                </field>
                <group>
                    <group string="Jami">
                        <field name="basket_pcs" string="Korzinkalarda, dona"/>
                        <field name="basket_gross_kg" string="Brutto jami, kg"/>
                        <field name="basket_net_kg" string="Netto jami, kg" class="fw-bold"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="craf_extrusion_shift_view_list_korzinka" model="ir.ui.view">
        <field name="name">craf.extrusion.shift.list.korzinka</field>
        <field name="model">craf.extrusion.shift</field>
        <field name="inherit_id" ref="craf_extrusion.craf_extrusion_shift_view_list"/>
        <field name="arch" type="xml">
            <field name="output_pcs" position="before">
                <field name="basket_count" sum="Jami" string="Korzinka"/>
                <field name="basket_net_kg" sum="Jami" string="Netto, kg"/>
            </field>
        </field>
    </record>
</odoo>
