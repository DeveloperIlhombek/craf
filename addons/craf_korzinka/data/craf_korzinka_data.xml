<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_craf_basket" model="ir.sequence">
            <field name="name">Craf korzinka</field>
            <field name="code">craf.basket</field>
            <field name="prefix">K-</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_craf_chem_treatment" model="ir.sequence">
            <field name="name">Craf kimyoviy ishlov</field>
            <field name="code">craf.chem.treatment</field>
            <field name="prefix">KM-%(y)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="wc_chem" model="mrp.workcenter">
            <field name="name">Kimyoviy ishlov vannasi</field>
            <field name="code">KIM</field>
            <field name="sequence">25</field>
            <field name="oee_target">85</field>
            <field name="color">9</field>
        </record>
        <record id="equipment_chem_bath" model="maintenance.equipment">
            <field name="name">Kimyoviy ishlov vannasi</field>
            <field name="category_id" ref="craf_production.equipment_category_craf"/>
            <field name="craf_stage">chem</field>
        </record>
    </data>
</odoo>
