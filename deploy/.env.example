# install.sh .env ni o'zi yaratadi (tasodifiy parollar bilan). Bu — namuna.
# .env git ga kirmaydi.
DB_USER=odoo
DB_PASSWORD=bu-yerga-uzun-tasodifiy-parol
DB_NAME=craf
# Odoo master paroli (bazani tiklash/zaxira uchun); config/odoo.conf ga yoziladi
ADMIN_PASSWD=bu-yerga-uzun-tasodifiy-parol
# Domen
DOMAIN=craf.mentorme.uz
# Caddy rejimi uchun manzil (domen yoki :80)
SITE_ADDRESS=craf.mentorme.uz
# Bo'sh: nginx rejimi (serverdagi nginx + certbot); "caddy": Caddy 80/443 ni oladi
COMPOSE_PROFILES=
# Odoo faqat 127.0.0.1 da shu portlarda (nginx shu yerga yo'naltiradi)
ODOO_PORT=8069
ODOO_WS_PORT=8072
# Zaxira nusxalar necha kun saqlanadi
BACKUP_KEEP_DAYS=14
